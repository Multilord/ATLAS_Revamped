# Copy to .env. Never commit .env or put these values in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=90

# Local MongoDB (docker compose up -d mongodb), or your MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=atlas_solution_engine
MONGODB_TIMEOUT_MS=5000

# This installation is one local customer workspace; these are not login credentials.
WORKSPACE_CUSTOMER=My Workspace
CONSULTANT_NAME=Consultant
PORT=8000

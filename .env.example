# Copy to .env. Never commit .env or put these values in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TIMEOUT_SECONDS=90
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_REQUESTS_PER_DAY=20

# Local MongoDB (docker compose up -d mongodb), or your MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=atlas_solution_engine
MONGODB_TIMEOUT_MS=5000

# This installation is one local customer workspace; these are not login credentials.
WORKSPACE_CUSTOMER=My Workspace
CONSULTANT_NAME=Consultant
PORT=8000

# Optional installed ClamAV scanner. Absolute executable path; no shell arguments.
ATLAS_CLAMSCAN_PATH=
# Set 1 to block uploads when malware scanning is unavailable.
ATLAS_REQUIRE_MALWARE_SCAN=0
